<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Self-contained test runner (no test framework package), so the suite also runs where NuGet is not
    reachable. Run: dotnet run -c Release (exit code 0 = all passed).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TestTargetFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(TestTargetFramework)' != ''">$(TestTargetFramework)</TargetFramework>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ScanQa.Core\ScanQa.Core.csproj" UndefineProperties="RevitVersion;RevitApiDir;RevitTargetFramework" />
  </ItemGroup>
</Project>
